<?xml version="1.0" encoding="utf-8"?>
<network-security-config>
    <!-- O protocolo é HTTP apenas na rede local. O tráfego nunca sai para a internet. -->
    <base-config cleartextTrafficPermitted="true">
        <trust-anchors>
            <certificates src="system" />
        </trust-anchors>
    </base-config>
</network-security-config>
